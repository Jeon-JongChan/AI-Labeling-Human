# =============================================================================
# 1. VLM (이미지/표 분석) 공급자 및 모델 설정
# =============================================================================
# 공급자 선택: free | gemini | gemini+free | free+gemini | google | gpt | colab | local | auto (미지정 시 키/URL 유무에 따라 자동 감지)
# - gemini+free (또는 free+gemini): 복수 API 체인 통합 모드 (순차 전환 및 전체 소진 시 1시간 Sleep 복구)
# - free (또는 free_model): dsh-our-free-model 기반 완전 무료 VLM 게이트웨이 (API 키/로그인 불필요, Nemotron Super-VL 등)
# - gemini: Google Gemini API (공식 API 키 필요, 일일 1,500회 무료, model=all 순차 전환 및 1시간 Sleep 복구 지원)
# - google: Google AI 검색 모드 크롤러 (.tools/auto-query-web/google.py, 로그인 불필요)
# - gpt: ChatGPT 웹 크롤러 (.tools/auto-query-web/gpt.py, 1회 로그인 필요)
# - colab: 원격 GPU 서버 (.tools/colab/vlm_server_colab.ipynb)
# - local: 로컬 llama-server (Qwen2.5-VL GGUF)
# - auto: 가용한 최적 공급자 자동 감지 및 순차 폴백
VLM_PROVIDER=free

# [통합 체인 API 설정 (VLM_PROVIDER=gemini+free 또는 free+gemini)]
# VLM_CHAIN_FALLBACK_ON=limit   # 다음 공급자 전환 조건: limit(429 한도 초과 시에만 전환, 기본값) | all(모든 에러 발생 시 전환)
# VLM_CHAIN_SLEEP_INTERVAL=3600 # 모든 공급자 소진 시 Sleep 대기 시간(초, 기본: 1시간)

# [A. Google AI 모드 웹 크롤러] VLM_PROVIDER=google (.tools/auto-query-web/google.py)
# - 로그인 불필요, Chromium 화면을 통해 즉시 질의 가능
# - 서버 기동: python .tools/auto-query-web/google.py
GOOGLE_CRAWLER_URL=http://127.0.0.1:8792

# [B. ChatGPT 웹 크롤러] VLM_PROVIDER=gpt (.tools/auto-query-web/gpt.py)
# - 최초 1회 수동 로그인 필요: python .tools/auto-query-web/gpt.py --login
# - 서버 기동: python .tools/auto-query-web/gpt.py
GPT_CRAWLER_URL=http://127.0.0.1:8791

# [C. Google Gemini API] VLM_PROVIDER=gemini (일일 1,500회 무료 API)
GEMINI_API_KEY=
# GEMINI_MODEL=all            # all 지정 시 가용 모델 역순(Pro -> Flash -> Lite) 자동 순차 사용 및 소진 시 1시간 Sleep 복구
# GEMINI_SLEEP_INTERVAL=3600  # 모든 모델 소진 시 Sleep 대기 시간(초, 기본: 1시간)

# [D. 완전 무료 VLM 게이트웨이 (dsh-our-free-model)] VLM_PROVIDER=free
# - API 키/회원가입 없이 즉시 사용 가능한 오픈소스 무료 멀티모달 비전 풀
# FREE_MODEL=all              # all 지정 시 가용 무료 비전 모델(Nemotron-VL, Dots-3 등) 순차 사용 및 소진 시 1시간 Sleep 복구
# FREE_MODEL_BASE_URL=https://api.kilo.ai/api/gateway
# FREE_MODEL_SLEEP_INTERVAL=3600

# [D. Colab 원격 GPU] VLM_PROVIDER=colab (.tools/colab/vlm_server_colab.ipynb)
# VLM_BASE_URL=https://xxxx.trycloudflare.com/v1

# [E. 로컬 llama-server] VLM_PROVIDER=local (Qwen2.5-VL-3B)
# VLM_PORT=8090
# VLM_BASE_URL=http://localhost:8090/v1
# VLM_HF_REPO=ggml-org/Qwen2.5-VL-3B-Instruct-GGUF
# LLAMA_NGL=99              # GPU 오프로드 레이어 수 (전체: 99 또는 999)
# LLAMA_CPP_VARIANT=cuda    # cuda | vulkan | cpu (미지정 시 자동 감지)

# [VLM 공통 세부 튜닝]
# VLM_TIMEOUT=300.0         # 요청 대기 타임아웃(초)
# VLM_MAX_TOKENS=1536       # 캡션 생성 최대 토큰 수

# =============================================================================
# 2. PDF 파싱 및 문서 추출 엔진 설정
# =============================================================================
# 추출 엔진 선택: auto | opendataloader | pypdfium (기본 auto)
# - auto: OpenDataLoader(Java JRE 필요, 정밀 구조 분석) 우선 시도 -> 실패 시 pypdfium2로 자동 폴백
# - opendataloader: OpenDataLoader 전용 (문단/표/그림 레이아웃 정밀 인식)
# - pypdfium: pypdfium2 전용 (Java 설치 불필요, 빠른 내장 텍스트/이미지 크롭)
# EXTRACT_ENGINE=auto

# PDF 이미지 크롭 렌더링 배율 (1.0 = 72dpi, 2.0 = 144dpi, 3.0 = 216dpi)
# PDF_RENDER_SCALE=2.0

# =============================================================================
# 3. 문서 및 데이터 경로 설정
# =============================================================================
# LABELER_DOCS_DIR=../../data/docs        # PDF 원본 폴더 (기본: <project_root>/data/docs)
# LABELER_DATA_DIR=../../data/labeling    # DB 및 이미지 저장 폴더 (기본: <project_root>/data/labeling)

# =============================================================================
# 4. 웹 서버 설정
# =============================================================================
# LABELER_HOST=0.0.0.0      # 웹 UI 바인딩 호스트
# LABELER_PORT=8788         # 웹 UI 서비스 포트

# =============================================================================
# 5. OCR 및 하드웨어 가속 설정
# =============================================================================
# LABELER_DEVICE=cuda       # cuda | cpu (전역 디바이스, 미지정 시 PyTorch 환경 자동 감지)
# OCR_GPU=true              # true | false (EasyOCR GPU 가속 여부)
# OCR_CPU_THREADS=2         # 1~N (CPU 모드 실행 시 최대 스레드 수, 점유율 100% 폭주 방지)

# =============================================================================
# 6. [선택] auto-query-web 웹 질의 크롤러 세부 튜닝 (.tools/auto-query-web)
# =============================================================================
# [웹 질의 공통 설정: Google & ChatGPT 모두 적용]
# - 요청 간 최소 휴식 시간 (초, 봇/비정상 트래픽 탐지 완화, 대량 처리 시 10~20 권장)
WEB_QUERY_MIN_INTERVAL=20
# - 브라우저 창 표시 여부 (0: 창 표시 권장, 1: 헤드리스)
# WEB_QUERY_HEADLESS=0
# - 답변 대기 타임아웃(초)
# WEB_QUERY_TIMEOUT=180
# - 연속 실패 시 안전 중단(서킷 브레이커) 임계값
# WEB_QUERY_MAX_FAILS=3

# [개별 크롤러 접속 및 포트 설정]
# Google AI 모드 (:8792, 로그인 불필요)
GOOGLE_CRAWLER_URL=http://127.0.0.1:8792
# GOOGLE_CRAWLER_PORT=8792
# GOOGLE_AI_URL=https://www.google.com/search?udm=50&hl=ko

# ChatGPT 웹 (:8791, 1회 로그인 필요)
# GPT_CRAWLER_URL=http://127.0.0.1:8791
# GPT_CRAWLER_PORT=8791

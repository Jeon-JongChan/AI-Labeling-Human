# =============================================================================
# 1. VLM (이미지/표 분석) 설정
# =============================================================================
# [방법 A: Gemini API - 가장 권장 / 내 PC 부하 없음]
# 입력 시 Gemini 우선 사용 (미입력 시 로컬 Qwen2.5-VL 사용)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# [방법 B: Colab 원격 GPU 서버 연동 (colab/vlm_server_colab.ipynb)]
# Colab T4 GPU에서 Qwen2.5-VL-7B 서버를 띄운 후 출력된 Cloudflare 터널 URL을 지정합니다.
# VLM_PROVIDER=local
# VLM_BASE_URL=https://xxxx.trycloudflare.com/v1

# [방법 C: 로컬 PC llama-server (PC 자체 구동 시)]
# VLM_PROVIDER=local
# VLM_PORT=8090
# VLM_BASE_URL=http://localhost:8090/v1
# LLAMA_NGL=99

# =============================================================================
# 2. 문서 및 데이터 경로 설정
# =============================================================================
# PDF 문서 원본 디렉터리 (미지정 시 ../../data/docs 또는 ./data/docs)
# LABELER_DOCS_DIR=../../data/docs

# 라벨링 DB/추출 이미지 저장 디렉터리 (미지정 시 ../../data/labeling 또는 ./data/labeling)
# LABELER_DATA_DIR=../../data/labeling

# =============================================================================
# 3. 웹 서버 설정
# =============================================================================
# LABELER_HOST=0.0.0.0
# LABELER_PORT=8788

# =============================================================================
# 4. 하드웨어 가속 (GPU / CPU) 설정
# =============================================================================
# 전역 디바이스 강제 지정 (cuda | cpu, 미지정 시 자동 감지)
# LABELER_DEVICE=cuda

# EasyOCR GPU 가속 사용 여부 (true | false)
# OCR_GPU=true
